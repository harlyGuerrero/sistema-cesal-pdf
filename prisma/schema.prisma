// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Modelo conceptual: ver ARCHITECTURE.md secciones 5 y 6, y la planificación
// de Activos (Fase 1). Product/Category del pipeline de PDFs se fusionaron
// con el módulo patrimonial: Activo (antes Product) y TipoActivo (antes
// Category) son la misma tabla, no hay dos entidades paralelas.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Categorías patrimoniales cerradas (ver ARCHITECTURE.md 5.2). No agregar OTROS.
enum TipoActivoCode {
  EQUIPOS_INFORMATICOS
  EQUIPOS_DE_OFICINA
  MUEBLES_DE_OFICINA
  BIENES_VEHICULARES
  EQUIPOS_DE_MAQUINARIA
  BIENES_INMUEBLES
}

// Relevancia: distinta del tipo de activo (ver skill product-classification).
enum Relevance {
  PRODUCT
  CONSUMABLE
  SERVICE
  OTHER
}

enum ImportStatus {
  UPLOADED
  PROCESSING
  READY_FOR_REVIEW
  COMPLETED
  FAILED
}

// Estado de cada fila detectada. IGNORED = relevance != PRODUCT (auto, sin revisión).
// REVIEW_REQUIRED = confidence baja/media. CONFIRMED/REJECTED = decisión humana o auto (confidence alta).
enum ImportItemStatus {
  REVIEW_REQUIRED
  CONFIRMED
  REJECTED
  IGNORED
}

// Qué produjo la clasificación de un ImportItem (relevance y/o tipo de activo).
enum ClassificationMethod {
  RULE
  OLLAMA
  MANUAL
}

enum ProcessingEngine {
  DOCLING
  OCR
  GLM_OCR
  GRANITE_DOCLING
  OLLAMA
}

enum ProcessingAttemptStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Macrozona geográfica de una Sede. Set fijo, igual que TipoActivoCode.
enum Region {
  COSTA
  SIERRA
  SELVA
}

// Situación patrimonial de un Activo — distinta de su condición física
// (ver planificación de Activos §4, "no mezclar ambos conceptos").
enum EstadoPatrimonial {
  DISPONIBLE
  ASIGNADO
  MANTENIMIENTO
  BAJA
}

// Estado físico observado del Activo. Nulo hasta que alguien lo registre.
enum CondicionFisica {
  NUEVO
  BUENO
  REGULAR
  MALO
  DETERIORADO
}

// Tipo de dato de un CampoEspecificacion — determina qué columna de
// ActivoEspecificacionValor (Fase 4) se usa para guardar el valor.
enum TipoDato {
  TEXTO
  NUMERO_ENTERO
  NUMERO_DECIMAL
  FECHA
  BOOLEANO
  SELECCION
  CATALOGO
  URL
}

// Qué generó un Movimiento (Fase 9). No hay CRUD directo de Movimiento — se
// infiere y se escribe como efecto de una acción sobre Activo (ver
// lib/activos/movimientos.ts).
enum TipoMovimiento {
  ALTA
  ASIGNACION
  REASIGNACION
  CAMBIO_RESPONSABLE
  TRANSFERENCIA
  CAMBIO_UBICACION
  MANTENIMIENTO
  RETORNO_MANTENIMIENTO
  BAJA
  REACTIVACION
}

enum TipoDocumento {
  FACTURA
  COMPROBANTE
  ACTA_ENTREGA
  ACTA_ASIGNACION
  ACTA_TRANSFERENCIA
  DOCUMENTO_BAJA
  GARANTIA
  FICHA_TECNICA
  CERTIFICADO
  FOTOGRAFIA
  OTRO
}

// Fase 11: "qué hizo el usuario en el sistema" — distinto de TipoMovimiento
// ("qué le pasó al activo"). Ver AuditoriaLog.
enum TipoAccionAuditoria {
  CREAR
  ACTUALIZAR
  ELIMINAR
  DAR_DE_ALTA
  DAR_DE_BAJA
  ASIGNAR
  TRANSFERIR
  ADJUNTAR_DOCUMENTO
  ELIMINAR_DOCUMENTO
}

// Fase 13: los únicos dos roles del sistema (ver CLAUDE.md). SUPER_ADMIN
// tiene todo lo de ADMIN más la gestión de Usuario (crear/editar/eliminar
// cuentas, asignar roles) — ver proxy.ts y lib/auth/session.ts.
enum RolUsuario {
  SUPER_ADMIN
  ADMIN
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

// Los 6 tipos de activo patrimonial, cerrados (ver ARCHITECTURE.md 5.2 y
// planificación de Activos §4). Antes "Category" — mismo mapeo de tabla,
// solo cambia el nombre del modelo Prisma.
model TipoActivo {
  id   String         @id @default(cuid())
  code TipoActivoCode @unique
  name String

  activos     Activo[]
  importItems ImportItem[]
  categorias  CategoriaActivo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// Nivel administrable bajo un TipoActivo (ej. "Redes y conectividad" bajo
// Equipos Informáticos). Inspirado en categorías/subcategorías de WordPress,
// pero con profundidad fija de 2 niveles (ver planificación de Activos §6).
model CategoriaActivo {
  id           String     @id @default(cuid())
  tipoActivoId String
  tipoActivo   TipoActivo @relation(fields: [tipoActivoId], references: [id])
  nombre       String
  slug         String
  estado       Boolean    @default(true)
  orden        Int        @default(0)

  subcategorias SubcategoriaActivo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipoActivoId, slug])
  @@index([tipoActivoId])
  @@map("categorias_activo")
}

// Segundo nivel administrable bajo una CategoriaActivo (ej. "Router" bajo
// Redes y conectividad). Punto de anclaje de CampoEspecificacion (Fase 4).
model SubcategoriaActivo {
  id          String          @id @default(cuid())
  categoriaId String
  categoria   CategoriaActivo @relation(fields: [categoriaId], references: [id])
  nombre      String
  slug        String
  estado      Boolean         @default(true)
  orden       Int             @default(0)

  campos  CampoEspecificacion[]
  activos Activo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoriaId, slug])
  @@index([categoriaId])
  @@map("subcategorias_activo")
}

// Catálogo genérico reutilizable (ej. MARCA, SISTEMA_OPERATIVO) — respalda
// campos de tipo SELECCION/CATALOGO en vez de texto libre repetido.
model Catalogo {
  id     String @id @default(cuid())
  codigo String @unique
  nombre String

  valores CatalogoValor[]
  campos  CampoEspecificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catalogos")
}

model CatalogoValor {
  id         String   @id @default(cuid())
  catalogoId String
  catalogo   Catalogo @relation(fields: [catalogoId], references: [id])
  valor      String
  estado     Boolean  @default(true)
  orden      Int      @default(0)

  especificaciones ActivoEspecificacionValor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([catalogoId, valor])
  @@index([catalogoId])
  @@map("catalogo_valores")
}

// Definición de un campo de especificación técnica por subcategoría (ej.
// "Memoria RAM", número, unidad GB, bajo Laptop). Administrable, no
// hardcodeado — el valor real que captura cada Activo vive en
// ActivoEspecificacionValor.
model CampoEspecificacion {
  id             String             @id @default(cuid())
  subcategoriaId String
  subcategoria   SubcategoriaActivo @relation(fields: [subcategoriaId], references: [id])
  nombre         String
  etiqueta       String
  tipoDato       TipoDato
  unidad         String?
  catalogoId     String?
  catalogo       Catalogo?          @relation(fields: [catalogoId], references: [id])
  obligatorio    Boolean            @default(false)
  estado         Boolean            @default(true)
  orden          Int                @default(0)

  valores ActivoEspecificacionValor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subcategoriaId, nombre])
  @@index([subcategoriaId])
  @@index([catalogoId])
  @@map("campos_especificacion")
}

// Valor concreto de un CampoEspecificacion para un Activo puntual (Fase 4).
// Columnas tipadas en vez de un único `valor: string` — permite ordenar y
// filtrar por el tipo real sin castear en cada query (ver planificación de
// Activos §6). Solo la columna que corresponde al tipoDato del campo se
// llena; el resto queda null. Todavía sin consumidor real: el formulario que
// las escribe llega en Fase 6, junto con el alta/edición de Activo.
model ActivoEspecificacionValor {
  id       String              @id @default(cuid())
  activoId String
  activo   Activo              @relation(fields: [activoId], references: [id], onDelete: Cascade)
  campoId  String
  campo    CampoEspecificacion @relation(fields: [campoId], references: [id])

  valorTexto           String?
  valorNumero          Decimal?       @db.Decimal(18, 4)
  valorFecha           DateTime?
  valorBooleano        Boolean?
  valorCatalogoValorId String?
  valorCatalogoValor   CatalogoValor? @relation(fields: [valorCatalogoValorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activoId, campoId])
  @@index([campoId])
  @@index([valorCatalogoValorId])
  @@map("activo_especificacion_valores")
}

// Proveedor que vendió un Activo (ej. la factura de compra). Catálogo simple
// — se resuelve por razonSocial (find-or-create) desde el formulario de
// Activo, mismo criterio que Sede/Catalogo: es un dato de referencia, no una
// unidad física, así que sí tiene sentido deduplicarlo por nombre.
model Proveedor {
  id          String  @id @default(cuid())
  razonSocial String  @unique
  documento   String?
  contacto    String?
  estado      Boolean @default(true)

  activos Activo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("proveedores")
}

// Fase 8 de Activos: quien opera el sistema — sin login todavía (fuera de
// alcance, ver CLAUDE.md). Existe para poder referenciar "quién" desde
// Movimiento/Auditoría (Fase 9/11) sin inventar autenticación real antes de
// tiempo. No confundir con Responsable: un Usuario puede no ser responsable
// de ningún activo, y viceversa.
// Fase 13: gana login real — email + passwordHash + rol. El primer
// SUPER_ADMIN se crea con scripts/crear-super-admin.ts (ver README), no por
// seed, para no dejar una contraseña fija escrita en el repo.
model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(ADMIN)
  estado       Boolean    @default(true)

  movimientos        Movimiento[]
  documentosCargados Documento[]
  auditoriaLogs      AuditoriaLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

// Persona de CESAL a la que se puede asignar un Activo. No implica acceso al
// sistema (ver Usuario) — puede ser cualquier trabajador, tenga o no cuenta.
model Responsable {
  id        String  @id @default(cuid())
  nombre    String
  documento String?
  cargo     String?
  sedeId    String?
  sede      Sede?   @relation(fields: [sedeId], references: [id])
  estado    Boolean @default(true)

  activos Activo[]

  movimientosComoAnterior Movimiento[] @relation("MovimientoResponsableAnterior")
  movimientosComoNuevo    Movimiento[] @relation("MovimientoResponsableNuevo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("responsables")
}

// Historial inmutable de cambios patrimoniales de un Activo (Fase 9). No
// tiene CRUD propio — se crea como efecto de una acción (alta, asignación,
// transferencia, cambio de estado) dentro de la misma transacción que
// modifica el Activo. Guarda snapshot de "antes" y "después" aunque el campo
// no haya sido la razón principal del movimiento, para no perder contexto.
model Movimiento {
  id       String @id @default(cuid())
  activoId String
  activo   Activo @relation(fields: [activoId], references: [id], onDelete: Cascade)

  tipo  TipoMovimiento
  fecha DateTime       @default(now())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  responsableAnteriorId String?
  responsableAnterior   Responsable? @relation("MovimientoResponsableAnterior", fields: [responsableAnteriorId], references: [id])
  responsableNuevoId    String?
  responsableNuevo      Responsable? @relation("MovimientoResponsableNuevo", fields: [responsableNuevoId], references: [id])

  sedeAnteriorId String?
  sedeAnterior   Sede?   @relation("MovimientoSedeAnterior", fields: [sedeAnteriorId], references: [id])
  sedeNuevaId    String?
  sedeNueva      Sede?   @relation("MovimientoSedeNueva", fields: [sedeNuevaId], references: [id])

  unidadOperativaAnteriorId String?
  unidadOperativaAnterior   UnidadOperativa? @relation("MovimientoUnidadAnterior", fields: [unidadOperativaAnteriorId], references: [id])
  unidadOperativaNuevaId    String?
  unidadOperativaNueva      UnidadOperativa? @relation("MovimientoUnidadNueva", fields: [unidadOperativaNuevaId], references: [id])

  ambienteAnteriorId String?
  ambienteAnterior   Ambiente? @relation("MovimientoAmbienteAnterior", fields: [ambienteAnteriorId], references: [id])
  ambienteNuevoId    String?
  ambienteNuevo      Ambiente? @relation("MovimientoAmbienteNuevo", fields: [ambienteNuevoId], references: [id])

  estadoAnterior EstadoPatrimonial?
  estadoNuevo    EstadoPatrimonial?

  motivo        String?
  observaciones String?

  createdAt DateTime @default(now())

  @@index([activoId])
  @@index([tipo])
  @@index([usuarioId])
  @@map("movimientos")
}

// Documento adjunto a un Activo (Fase 10). El archivo físico no vive en esta
// tabla ni en un directorio público — se guarda fuera de git en
// document-storage/activos/<activoId>/<uuid><extensión> (ver
// lib/documentos/storage.ts) y se sirve mediante GET /api/documentos/[id],
// nunca por ruta directa. `url` guarda solo el nombre de archivo generado,
// no una URL pública ni el nombre original del usuario (ver nombreOriginal).
model Documento {
  id String @id @default(cuid())

  activoId String
  activo   Activo @relation(fields: [activoId], references: [id], onDelete: Cascade)

  tipoDocumento  TipoDocumento
  nombre         String
  nombreOriginal String
  url            String
  mimeType       String
  extension      String
  tamanoBytes    Int
  descripcion    String?

  // Soft-delete: no se borra el archivo físico al "eliminar" un documento,
  // solo se oculta de la UI — mantiene trazabilidad (ver planificación de
  // Activos §15).
  estado Boolean @default(true)

  usuarioCargaId String?
  usuarioCarga   Usuario? @relation(fields: [usuarioCargaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activoId])
  @@index([tipoDocumento])
  @@map("documentos")
}

// Log genérico de acciones del sistema (Fase 11) — "qué hizo el usuario",
// distinto de Movimiento ("qué le pasó al activo", Fase 9). Una sola tabla
// para todas las entidades: entidad+entidadId es una referencia lógica, no
// una FK tipada — así no hace falta una tabla de auditoría por entidad, y
// sigue funcionando aunque la fila referenciada se borre después.
model AuditoriaLog {
  id String @id @default(cuid())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  accion    TipoAccionAuditoria
  entidad   String
  entidadId String
  detalle   Json?

  fecha DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([accion])
  @@map("auditoria_logs")
}

// Activo patrimonial individual — antes "Product" (producto lógico
// compartido entre importaciones). Ya no se deduplica por nombre: cada
// unidad física es su propia fila (ver planificación de Activos, decisión
// "Product se fusiona en Activo" + "1 Activo por unidad").
//
// responsableActualId llega en Fase 8, cuando exista Responsable — no se
// agrega vacío de antemano.
model Activo {
  id                String  @id @default(cuid())
  codigoPatrimonial String? @unique
  nombreActivo      String
  nombreNormalizado String
  descripcion       String?

  // Siempre se conoce, aun para un Activo creado desde el pipeline de PDFs
  // (la clasificación por Ollama/reglas trabaja a este nivel — ver
  // ARCHITECTURE.md 5.2). subcategoriaId, en cambio, es opcional: un Activo
  // recién importado no la trae, alguien la completa después editándolo.
  tipoActivoId String
  tipoActivo   TipoActivo @relation(fields: [tipoActivoId], references: [id])

  // Denormalizado desde subcategoria.categoria.tipoActivo cuando existe — se
  // deriva en el server action, nunca se elige por separado (ver
  // app/activos/actions.ts). Opcional: un Activo recién creado por el
  // pipeline de PDFs solo trae tipoActivoId, no la subcategoría fina — eso
  // requiere un humano. El alta manual (Fase 6) sí la exige a nivel de
  // formulario, aunque la columna lo permita null.
  subcategoriaId String?
  subcategoria   SubcategoriaActivo? @relation(fields: [subcategoriaId], references: [id])

  // sedeId también es opcional por el mismo motivo: un Activo recién
  // importado no tiene ubicación física conocida hasta que alguien lo
  // registra. El alta manual la exige a nivel de formulario.
  sedeId            String?
  sede              Sede?            @relation(fields: [sedeId], references: [id])
  unidadOperativaId String?
  unidadOperativa   UnidadOperativa? @relation(fields: [unidadOperativaId], references: [id])
  ambienteId        String?
  ambiente          Ambiente?        @relation(fields: [ambienteId], references: [id])

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  // Fase 8: quién tiene el activo asignado hoy. No es historial — el
  // historial de asignaciones/transferencias vive en Movimiento (Fase 9);
  // esto es solo "el responsable actual", como dice el nombre.
  responsableActualId String?
  responsableActual   Responsable? @relation(fields: [responsableActualId], references: [id])

  fechaAdquisicion DateTime?
  numeroFactura    String?
  codigoProyecto   String?

  costoAdquisicion Decimal? @db.Decimal(14, 2)
  valorContable    Decimal? @db.Decimal(14, 2)
  valorActual      Decimal? @db.Decimal(14, 2)

  estadoPatrimonial EstadoPatrimonial @default(DISPONIBLE)
  condicionFisica   CondicionFisica?

  observaciones String?

  // Trazabilidad opcional hacia el pipeline de PDFs: un Activo puede nacer
  // de una fila de importación confirmada, o crearse manualmente (migración
  // del Excel histórico, alta directa). Varios Activos pueden apuntar al
  // mismo ImportItem cuando su quantity > 1 (1 Activo por unidad física).
  importItemId String?
  importItem   ImportItem? @relation(fields: [importItemId], references: [id])

  especificaciones ActivoEspecificacionValor[]
  movimientos      Movimiento[]
  documentos       Documento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombreNormalizado])
  @@index([tipoActivoId])
  @@index([subcategoriaId])
  @@index([sedeId])
  @@index([unidadOperativaId])
  @@index([ambienteId])
  @@index([proveedorId])
  @@index([responsableActualId])
  @@index([importItemId])
  @@map("activos")
}

model Import {
  id           String       @id @default(cuid())
  fileName     String
  fileHash     String       @unique
  fileSize     Int
  mimeType     String
  status       ImportStatus @default(UPLOADED)
  errorMessage String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  items              ImportItem[]
  processingAttempts ProcessingAttempt[]

  @@index([status])
  @@map("imports")
}

// Fila de producto detectada en un PDF. Puente entre lo extraído y los
// Activo(s) patrimoniales que genera al confirmarse (ver skill import-workflow).
model ImportItem {
  id String @id @default(cuid())

  importId String
  import   Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  // Origen: nunca se modifica una vez creado (ver skill pdf-extraction).
  rawText     String
  sourcePage  Int
  sourceTable Int
  sourceRow   Int

  // Normalización (ver skill validation / Normalizer, Fase 5).
  normalizedName String?
  quantity       Decimal? @db.Decimal(14, 3)
  unitPrice      Decimal? @db.Decimal(14, 2)
  totalPrice     Decimal? @db.Decimal(14, 2)
  currency       String?

  // Clasificación (ver skill product-classification). Relevance y tipo de
  // activo son decisiones independientes (Fase 6 y Fase 7 del pipeline) con
  // su propio método/confidence cada una — no un único par
  // classificationMethod/confidence, que perdería cuál de las dos vino de
  // Ollama y con qué confianza.
  relevance           Relevance?
  relevanceMethod     ClassificationMethod?
  relevanceConfidence Float?
  tipoActivoId        String?
  tipoActivo          TipoActivo?           @relation(fields: [tipoActivoId], references: [id])
  categoryMethod      ClassificationMethod?
  categoryConfidence  Float?

  // Revisión (ver Fase 9).
  status      ImportItemStatus @default(REVIEW_REQUIRED)
  reviewNotes String?
  reviewedAt  DateTime?
  reviewedBy  String?

  // Activo(s) generados al confirmar (Fase 1 de Activos): 1 por unidad
  // física, según quantity. Ya no hay un único productId — puede ser 0..N.
  activos Activo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importId])
  @@index([status])
  @@index([tipoActivoId])
  @@map("import_items")
}

// Registro de motor usado por intento de procesamiento de un Import
// (ver ARCHITECTURE.md 6, skill import-workflow / document-ai).
model ProcessingAttempt {
  id String @id @default(cuid())

  importId String
  import   Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  engine ProcessingEngine
  model  String?
  status ProcessingAttemptStatus @default(RUNNING)

  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationMs   Int?
  errorMessage String?
  metadata     Json?

  @@index([importId])
  @@index([engine])
  @@map("processing_attempts")
}

// Sede física de la organización (nivel ciudad, ej. "Huachipa"). Fase 5 de
// Activos: reestructurada desde el modelo plano de Fase B — lo que antes era
// Sede.name (ej. "CAE - Huachipa") ahora es UnidadOperativa.name, y lo que
// antes era Sede.city ahora es este Sede.name. Todavía sin relación a Activo
// (eso llega en Fase 6, cuando cada activo tenga una sede asignada).
model Sede {
  id     String @id @default(cuid())
  name   String @unique
  region Region

  unidadesOperativas UnidadOperativa[]
  ambientes          Ambiente[]
  activos            Activo[]
  responsables       Responsable[]

  movimientosComoAnterior Movimiento[] @relation("MovimientoSedeAnterior")
  movimientosComoNueva    Movimiento[] @relation("MovimientoSedeNueva")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@map("sedes")
}

// Unidad administrativa/física dentro de una Sede (ej. "CAE - Huachipa" bajo
// Huachipa). Opcional a nivel de Sede a propósito: Abancay, Andahuaylas,
// Apurímac y Atalaya todavía no tienen ninguna definida — no se inventan
// unidades ficticias para rellenar el hueco.
model UnidadOperativa {
  id     String @id @default(cuid())
  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id])
  name   String

  ambientes Ambiente[]
  activos   Activo[]

  movimientosComoAnterior Movimiento[] @relation("MovimientoUnidadAnterior")
  movimientosComoNueva    Movimiento[] @relation("MovimientoUnidadNueva")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, name])
  @@index([sedeId])
  @@map("unidades_operativas")
}

// Espacio físico dentro de una Sede (ej. un almacén, una oficina). sedeId es
// siempre obligatorio; unidadOperativaId es opcional para cubrir sedes que
// todavía no tienen unidad operativa propia. Si se define, debe pertenecer a
// la misma sedeId — Prisma no expresa esa condición como FK compuesta, se
// valida en el server action (ver app/sedes/actions.ts).
model Ambiente {
  id                String           @id @default(cuid())
  sedeId            String
  sede              Sede             @relation(fields: [sedeId], references: [id])
  unidadOperativaId String?
  unidadOperativa   UnidadOperativa? @relation(fields: [unidadOperativaId], references: [id])
  name              String

  activos Activo[]

  movimientosComoAnterior Movimiento[] @relation("MovimientoAmbienteAnterior")
  movimientosComoNuevo    Movimiento[] @relation("MovimientoAmbienteNuevo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@index([unidadOperativaId])
  @@map("ambientes")
}
